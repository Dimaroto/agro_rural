{
  "name": "agro-rural-desktop",
  "version": "1.1.7",
  "private": true,
  "description": "App Windows Agro Rural — admin + emissor NF-e (Edem Software)",
  "author": "Edem Software",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win --x64 --dir"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.com.edemsoftware.agrorural",
    "productName": "AgroRural",
    "copyright": "Copyright © 2026 Edem Software",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "toolbar.html",
      "assets/**"
    ],
    "win": {
      "icon": "assets/logo.ico",
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    },
    "forceCodeSigning": false,
    "asar": true
  }
}
