# Desenvolvimento local (PostgreSQL via Docker — docker compose up -d)
DATABASE_URL="postgresql://catalogo:catalogo@localhost:5432/catalogo"
DATABASE_URL_UNPOOLED="postgresql://catalogo:catalogo@localhost:5432/catalogo"

# Produção Vercel + Neon (a integração Neon preenche sozinha)
# DATABASE_URL=postgresql://...@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://...@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# DIRECT_URL=igual à UNPOOLED (alias)

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Produção: NEXT_PUBLIC_APP_URL="https://agroruralzortea.com.br"
DEFAULT_STORE_SLUG="saboart"
NEXT_PUBLIC_DEFAULT_STORE_SLUG="saboart"
NEXT_PUBLIC_STORE_PICKUP_ADDRESS="Rua Luiz Pedron, 357, Bairro Andorinhas, Zortéa - SC"
# NEXT_PUBLIC_STORE_PICKUP_MAPS_URL="https://maps.google.com/..."
NEXT_PUBLIC_PIX_KEY="49984376190"
NEXT_PUBLIC_STORE_NAME="SaboArt da Dag"
AUTH_SECRET="gere-um-secret-aleatorio-aqui"

# Upload de imagens — Vercel Blob (produção na Vercel)
# Crie um Blob store no painel Vercel; o token e injetado automaticamente.
# Em dev local, deixe vazio para gravar em public/uploads/
BLOB_READ_WRITE_TOKEN=""

# Instalador Windows do emissor (URL pública no Blob). Aba /admin/emissor
# EMISSOR_SETUP_URL="https://....blob.vercel-storage.com/emissor/AgroRural-Setup.exe"
# NEXT_PUBLIC_EMISSOR_SETUP_URL=""

# Auth do cliente (mock local com Prisma; futuro: firebase)
CUSTOMER_AUTH_PROVIDER="mock"

# Firebase (fase 2 — deixe vazio no mock)
# NEXT_PUBLIC_FIREBASE_API_KEY=""
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
# FIREBASE_ADMIN_PROJECT_ID=""
# FIREBASE_ADMIN_CLIENT_EMAIL=""
# FIREBASE_ADMIN_PRIVATE_KEY=""

# Pagamentos PIX (v2) — false na v1, true para habilitar checkout
PAYMENTS_ENABLED="false"
NEXT_PUBLIC_PAYMENTS_ENABLED="false"
NEXT_PUBLIC_CARD_PAYMENTS_ENABLED="false"

# Mercado Pago (opcional — sem token usa provedor mock em dev)
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""
# Public Key para o formulário de cartão no carrinho (Brick)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=""

# Asaas — cartão de crédito/débito via Checkout hospedado
# Sandbox: https://sandbox.asaas.com | Produção: https://www.asaas.com
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"
# ASAAS_API_URL="https://api-sandbox.asaas.com/v3"
ASAAS_WEBHOOK_TOKEN=""
# Webhook no painel Asaas: POST https://SEU_DOMINIO/api/webhooks/asaas
# Eventos: CHECKOUT_PAID, CHECKOUT_EXPIRED, CHECKOUT_CANCELED

# Tempo de expiração do pedido PIX (minutos)
PIX_ORDER_EXPIRY_MINUTES="30"
# Tempo de expiração do checkout de cartão (minutos, 10–1440)
CHECKOUT_EXPIRY_MINUTES="60"
