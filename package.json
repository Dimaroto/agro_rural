{
  "name": "saboart",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "db:local": "node scripts/start-local-postgres.mjs",
    "dev:mobile": "next dev -H 0.0.0.0",
    "open:mobile": "open-mobile-catalog.bat",
    "build": "prisma generate && next build",
    "build:hostgator": "node scripts/build-hostgator.mjs",
    "build:hostgator:db": "node scripts/build-hostgator.mjs --with-db",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node scripts/write-product-images.mjs && npx tsx prisma/seed.ts",
    "db:setup:prod": "node scripts/setup-production-db.mjs",
    "db:push:prod": "node scripts/push-prod-schema.cjs",
    "admin:update": "npx tsx scripts/update-admin-user.ts",
    "admin:update:prod": "npx tsx scripts/update-admin-user.ts --production",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "overrides": {
    "postcss": "^8.5.15"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.2",
    "@prisma/client": "^6.19.0",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
    "next": "16.2.6",
    "next-auth": "^5.0.0-beta.31",
    "prisma": "^6.19.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.2.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "sharp": "^0.35.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.3",
    "typescript": "^5"
  }
}
