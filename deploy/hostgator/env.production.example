# Copie para .env na raiz do app na HostGator (cPanel > Node.js > Environment variables)

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# URL publica do site (sem barra no final)
NEXT_PUBLIC_APP_URL=https://seudominio.com.br

# Loja padrao
DEFAULT_STORE_SLUG=saboart
NEXT_PUBLIC_DEFAULT_STORE_SLUG=saboart

# Banco SQLite (pasta data/ deve ter permissao de escrita)
DATABASE_URL=file:./data/catalogo.db

# Gere um valor aleatorio forte (min. 32 caracteres)
AUTH_SECRET=substitua-por-um-secret-aleatorio-forte

# Auth do cliente
CUSTOMER_AUTH_PROVIDER=mock

# Pagamentos PIX
PAYMENTS_ENABLED=false
NEXT_PUBLIC_PAYMENTS_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PIX_ORDER_EXPIRY_MINUTES=30
